{
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "always",
        }
    },
    "files.associations": {
        "array": "cpp",
        "string_view": "cpp",
        "initializer_list": "cpp",
        "utility": "cpp"
    },
    "iis.configDir": "",
    "terminal.integrated.profiles.linux": {
    "hly": {
        "path": "/bin/bash",
        "args": [
        "-c",
        "su - hly"]
    },
    "hly_tty": {
        "path": "/bin/bash",
        "args": [
        "-c",
        "su - hly -c 'cd /home/hly/projects/llm-agent/verl-agent && exec bash'"        ]
    }
    },
    "terminal.integrated.defaultProfile.linux": "hly"
}